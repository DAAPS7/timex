{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["./**/*.ts", "../worker", "../shared", "../backend/api", "../backend/core", "../backend/ai", "../backend/domains", "../backend/domains/planning/*.ts"],
  "exclude": ["../backend/**/*.test.ts"]
}
